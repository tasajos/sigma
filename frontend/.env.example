# En desarrollo, deja VITE_API_URL y VITE_SOCKET_URL sin definir: la app
# usa el mismo origen que la sirve (proxy de Vite hacia el backend), así
# funciona igual entrando por localhost o por la IP del equipo en la red.
# En producción, si el frontend y el backend NO comparten dominio, defínelas
# con la URL pública real del backend:
# VITE_API_URL=https://api.tu-dominio.org/api
# VITE_SOCKET_URL=https://api.tu-dominio.org
VITE_ORG_NOMBRE=Centro de Operaciones de Emergencia
VITE_MAPA_LAT=-17.3895
VITE_MAPA_LNG=-66.1568
VITE_MAPA_ZOOM=13
